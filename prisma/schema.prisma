datasource db {
  provider = "postgresql" // Supabase native database (or "mysql" for external MySQL provider)
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
  TESTER
}

enum Category {
  Phones
  Computers
  Tablets
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  orders    Order[]
}

model Product {
  id          String      @id @default(uuid())
  name        String
  category    Category
  price       Float
  rating      Float       @default(4.5)
  specs       String
  image       String
  stock       Int         @default(10)
  createdAt   DateTime    @default(now())
  orderItems  OrderItem[]
}

model Order {
  id            String      @id @default(uuid())
  userId        String?
  user          User?       @relation(fields: [userId], references: [id])
  customerName  String
  total         Float
  paymentMethod String
  status        String      @default("Paid & Processing")
  createdAt     DateTime    @default(now())
  items         OrderItem[]
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

model Defect {
  id        String   @id @default(uuid())
  title     String
  severity  String
  priority  String
  status    String   @default("Open")
  reporter  String
  module    String
  steps     String
  expected  String
  actual    String
  createdAt DateTime @default(now())
}